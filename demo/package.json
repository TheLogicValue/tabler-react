{
  "name": "tabler-react-demo",
  "version": "0.0.0",
  "packageManager": "npm@11.19.0",
  "description": "Independent integration playground for the Tabler React component library.",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^20.19.0 || ^22.13.0 || >=24.0.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": "^11.0.0",
      "onFail": "warn"
    }
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5174 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5174 --strictPort"
  },
  "dependencies": {
    "ag-grid-community": "32.3.9",
    "ag-grid-react": "32.3.9",
    "echarts": "6.1.0",
    "echarts-for-react": "3.0.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "vite": "7.3.7"
  }
}
