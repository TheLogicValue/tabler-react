  "guide": {
    "summary": "Tarjeta para componer imágenes y detalles de una galería.",
    "behavior": [
      "GalleryCard.Image, Details y Footer permiten componer las partes.",
      "No carga una colección ni implementa por sí misma un visor de imágenes."
    ],
    "example": "<GalleryCard><GalleryCard.Image src=\"/imagen-local.svg\" alt=\"Ilustración\" /><GalleryCard.Footer>Imagen de prueba</GalleryCard.Footer></GalleryCard>"
