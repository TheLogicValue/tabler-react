{
  "name": "tabler-react",
  "version": "1.41.5",
  "description": "",
  "author": "thelogicvalue",
  "license": "MIT",
  "repository": "thelogicvalue/tabler-react",
  "main": "dist/index.js",
  "module": "dist/index.es.js",
  "jsnext:main": "dist/index.es.js",
  "sideEffects": [
    "*.css",
    "**/*.css"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.es.js",
      "require": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "scripts": {
    "build": "yarn run copytablercsstodist && rollup -c",
    "start": "yarn run copytablercsstodist && rollup -c -w",
    "prepare": "yarn run build && yarn run copytablercsstodist",
    "lint": "eslint --ext .js src/**/*",
    "copytablercsstodist": "shx mkdir -p dist && shx cp -r src/fonts dist/"
  },
  "dependencies": {
    "ag-grid-react": "^32.3.9",
    "classnames": "^2.5.1",
    "date-fns": "^4.1.0",
    "echarts": "^6.0.0",
    "echarts-for-react": "^3.0.2",
    "focus-trap-react": "^11.0.4",
    "react-content-loader": "^7.1.1",
    "react-day-picker": "^8.10.1",
    "react-select": "^5.7.3",
    "@babel/runtime": "^7.28.0",
    "postcss": "^8.4.47"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "react-router-dom": "^7.0.0",
    "@popperjs/core": "^2.11.8",
    "react-popper": "^2.3.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/plugin-external-helpers": "^7.25.9",
    "@babel/plugin-syntax-dynamic-import": "^7.8.3",
    "@babel/plugin-syntax-import-meta": "^7.10.4",
    "@babel/plugin-transform-json-strings": "^7.25.9",
    "@babel/plugin-transform-runtime": "^7.28.5",
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-flow": "^7.25.9",
    "@babel/preset-react": "^7.25.9",
    "@popperjs/core": "^2.11.8",
    "@rollup/plugin-babel": "^6.1.0",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-url": "^8.0.2",
    "browserslist": "^4.24.2",
    "eslint": "^9.14.0",
    "eslint-config-react-app": "^7.0.1",
    "flow-copy-source": "^2.0.9",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-popper": "^2.3.0",
    "react-router-dom": "7.12.0",
    "rollup": "^4.54.0",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "rollup-plugin-postcss": "^4.0.2",
    "shx": "^0.4.0"
  },
  "files": [
    "dist"
  ],
  "resolutions": {}
